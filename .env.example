# Add your own OpenWeather API key here.
# Rename this file to .env in your project root and restart Expo.
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Backend API base URL (no trailing slash). Default targets Android emulator (10.0.2.2:5001).
# For iOS simulator or a physical device, use your machine's LAN IP after starting the backend on port 5001:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:5001
